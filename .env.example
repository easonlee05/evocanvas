# ==============================================================================
# EvoCanvas 在线网站生产部署环境变量配置模板
# 使用前请复制为 .env 文件: cp .env.example .env
# ==============================================================================

# ----------------- 必填：大模型 API 凭证 -----------------
# 默认使用 DeepSeek 模型提供商
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
# 选择 GPT-5.6 Sol/Terra/Luna 时使用 OpenAI Provider
OPENAI_API_KEY=sk-your-openai-api-key-here

# ----------------- 可选：模型与提供商设置 -----------------
# 默认 provider: deepseek
PI_PROVIDER=deepseek
# 默认模型: deepseek-v4-flash
PI_MODEL=deepseek-v4-flash
# 页面选择 GPT-5.6 时，Runtime 会按模型自动切换到 openai Provider；
# 选择 DeepSeek 时使用 deepseek Provider。

# ----------------- 服务网络与端口设置 -----------------
# 对外 Web 服务端口（容器端口映射或裸机监听端口，默认 8000）
PORT=8000

# ----------------- 内部安全密钥（可选） -----------------
# 用于 Pi Runtime 与 FastAPI 之间的私有内部通信鉴权，留空则使用默认配置
PI_RUNTIME_INTERNAL_SECRET=

# ----------------- 持久化存储目录设置 -----------------
# Docker 容器部署时内部固定挂载为 /data，此处无需修改
# 裸机直接运行时，可以指定本地存储路径：
EVO_STORAGE_DIR=./workspace-data
PI_STORAGE_DIR=./.pi-storage
