{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evocanvas.local/schemas/pi-runtime/v1-contracts.json",
  "title": "EvoCanvas Pi Session Integration Contracts v1",
  "description": "Machine-readable boundary for Workspace-Primary Pi Session binding, user submission idempotency, tool execution, semantic commit, and lifecycle outcomes.",
  "oneOf": [
    {"$ref": "#/$defs/WorkspaceSessionBinding"},
    {"$ref": "#/$defs/UserSubmissionRequest"},
    {"$ref": "#/$defs/UserSubmissionReceipt"},
    {"$ref": "#/$defs/WorkspaceCommitRequest"},
    {"$ref": "#/$defs/ToolExecutionRecord"},
    {"$ref": "#/$defs/SessionLifecycleCommand"},
    {"$ref": "#/$defs/SessionLifecycleResult"}
  ],
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "ContentHash": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{64}$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "SchemaVersion": {
      "const": "evocanvas.pi-runtime.v1"
    },
    "WorkspaceSessionBinding": {
      "type": "object",
      "required": [
        "contract_type",
        "schema_version",
        "workspace_id",
        "primary_session_id",
        "main_lane",
        "status",
        "pi_session_format_version",
        "session_file_ref",
        "created_at",
        "last_opened_at"
      ],
      "properties": {
        "contract_type": {"const": "workspace_session_binding"},
        "schema_version": {"$ref": "#/$defs/SchemaVersion"},
        "workspace_id": {"$ref": "#/$defs/Id"},
        "primary_session_id": {"$ref": "#/$defs/Id"},
        "main_lane": {"const": "main"},
        "status": {
          "type": "string",
          "enum": ["binding", "ready", "unavailable", "archived"]
        },
        "pi_session_format_version": {"$ref": "#/$defs/Id"},
        "session_file_ref": {"$ref": "#/$defs/Id"},
        "created_at": {"$ref": "#/$defs/Timestamp"},
        "last_opened_at": {"$ref": "#/$defs/Timestamp"},
        "predecessor_session_id": {"$ref": "#/$defs/Id"},
        "unavailable_reason": {"$ref": "#/$defs/Id"}
      },
      "additionalProperties": false
    },
    "UserSubmissionRequest": {
      "type": "object",
      "required": [
        "contract_type",
        "schema_version",
        "submission_id",
        "content_hash",
        "workspace_id",
        "actor_id",
        "pi_user_message"
      ],
      "properties": {
        "contract_type": {"const": "user_submission_request"},
        "schema_version": {"$ref": "#/$defs/SchemaVersion"},
        "submission_id": {"$ref": "#/$defs/Id"},
        "content_hash": {"$ref": "#/$defs/ContentHash"},
        "workspace_id": {"$ref": "#/$defs/Id"},
        "actor_id": {"$ref": "#/$defs/Id"},
        "pi_user_message": {
          "type": "object",
          "description": "Original Pi-supported user message. Product context must not be concatenated into this object."
        }
      },
      "additionalProperties": false
    },
    "UserSubmissionReceipt": {
      "type": "object",
      "required": [
        "contract_type",
        "schema_version",
        "status",
        "submission_id",
        "content_hash",
        "session_id",
        "entry_id",
        "binding_status"
      ],
      "properties": {
        "contract_type": {"const": "user_submission_receipt"},
        "schema_version": {"$ref": "#/$defs/SchemaVersion"},
        "status": {"type": "string", "enum": ["accepted", "duplicate"]},
        "submission_id": {"$ref": "#/$defs/Id"},
        "content_hash": {"$ref": "#/$defs/ContentHash"},
        "session_id": {"$ref": "#/$defs/Id"},
        "entry_id": {"$ref": "#/$defs/Id"},
        "binding_status": {"const": "ready"}
      },
      "additionalProperties": false
    },
    "ToolContext": {
      "type": "object",
      "required": [
        "workspace_id",
        "session_id",
        "turn_id",
        "entry_id",
        "invocation_id",
        "tool_call_id",
        "actor_id",
        "capabilities",
        "current_revision_id",
        "instruction_bundle_version",
        "active_skill_versions"
      ],
      "properties": {
        "workspace_id": {"$ref": "#/$defs/Id"},
        "session_id": {"$ref": "#/$defs/Id"},
        "turn_id": {"$ref": "#/$defs/Id"},
        "entry_id": {"$ref": "#/$defs/Id"},
        "invocation_id": {"$ref": "#/$defs/Id"},
        "tool_call_id": {"$ref": "#/$defs/Id"},
        "actor_id": {"$ref": "#/$defs/Id"},
        "capabilities": {"type": "array", "items": {"$ref": "#/$defs/Id"}, "uniqueItems": true},
        "current_revision_id": {"$ref": "#/$defs/Id"},
        "instruction_bundle_version": {"$ref": "#/$defs/Id"},
        "active_skill_versions": {"type": "array", "items": {"$ref": "#/$defs/Id"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "SemanticOperation": {
      "type": "object",
      "required": ["operation_id", "operation_type", "payload"],
      "properties": {
        "operation_id": {"$ref": "#/$defs/Id"},
        "operation_type": {
          "type": "string",
          "enum": [
            "create_object",
            "update_object",
            "change_status",
            "supersede_object",
            "create_relation",
            "remove_relation",
            "record_confirmation",
            "confirm_handoff",
            "suspend_handoff",
            "invalidate_handoff"
          ]
        },
        "payload": {"type": "object"}
      },
      "additionalProperties": false
    },
    "WorkspaceCommitRequest": {
      "type": "object",
      "required": [
        "contract_type",
        "schema_version",
        "tool_context",
        "base_revision_id",
        "idempotency_key",
        "request_hash",
        "operations",
        "confirmation_refs",
        "change_summary"
      ],
      "properties": {
        "contract_type": {"const": "workspace_commit_request"},
        "schema_version": {"$ref": "#/$defs/SchemaVersion"},
        "tool_context": {"$ref": "#/$defs/ToolContext"},
        "base_revision_id": {"$ref": "#/$defs/Id"},
        "idempotency_key": {"$ref": "#/$defs/Id"},
        "request_hash": {"$ref": "#/$defs/ContentHash"},
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/SemanticOperation"}
        },
        "confirmation_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/Id"},
          "uniqueItems": true
        },
        "change_summary": {"type": "string", "minLength": 1, "maxLength": 2000}
      },
      "additionalProperties": false
    },
    "ToolExecutionRecord": {
      "type": "object",
      "required": [
        "contract_type",
        "schema_version",
        "tool_name",
        "tool_version",
        "tool_context",
        "side_effect_class",
        "replay",
        "result_status",
        "request_hash",
        "started_at",
        "finished_at"
      ],
      "properties": {
        "contract_type": {"const": "tool_execution_record"},
        "schema_version": {"$ref": "#/$defs/SchemaVersion"},
        "tool_name": {"$ref": "#/$defs/Id"},
        "tool_version": {"$ref": "#/$defs/Id"},
        "tool_context": {"$ref": "#/$defs/ToolContext"},
        "side_effect_class": {"type": "string", "enum": ["none", "workspace", "external"]},
        "replay": {"type": "string", "enum": ["safe", "never"]},
        "result_status": {"type": "string", "enum": ["success", "failed", "unknown"]},
        "request_hash": {"$ref": "#/$defs/ContentHash"},
        "idempotency_key": {"$ref": "#/$defs/Id"},
        "effect_id": {"$ref": "#/$defs/Id"},
        "error_code": {"$ref": "#/$defs/Id"},
        "started_at": {"$ref": "#/$defs/Timestamp"},
        "finished_at": {"$ref": "#/$defs/Timestamp"}
      },
      "additionalProperties": false
    },
    "SessionLifecycleCommand": {
      "type": "object",
      "required": [
        "contract_type",
        "schema_version",
        "lifecycle_operation_id",
        "workspace_id",
        "action",
        "idempotency_key"
      ],
      "properties": {
        "contract_type": {"const": "session_lifecycle_command"},
        "schema_version": {"$ref": "#/$defs/SchemaVersion"},
        "lifecycle_operation_id": {"$ref": "#/$defs/Id"},
        "workspace_id": {"$ref": "#/$defs/Id"},
        "action": {"type": "string", "enum": ["close", "archive", "replace", "delete"]},
        "idempotency_key": {"$ref": "#/$defs/Id"},
        "replacement_session_id": {"$ref": "#/$defs/Id"}
      },
      "additionalProperties": false
    },
    "SessionLifecycleResult": {
      "type": "object",
      "required": [
        "contract_type",
        "schema_version",
        "lifecycle_operation_id",
        "workspace_id",
        "action",
        "outcome",
        "residual_targets"
      ],
      "properties": {
        "contract_type": {"const": "session_lifecycle_result"},
        "schema_version": {"$ref": "#/$defs/SchemaVersion"},
        "lifecycle_operation_id": {"$ref": "#/$defs/Id"},
        "workspace_id": {"$ref": "#/$defs/Id"},
        "action": {"type": "string", "enum": ["close", "archive", "replace", "delete"]},
        "outcome": {
          "type": "string",
          "enum": ["closed", "archived", "replaced", "deleted", "partial", "retention_held"]
        },
        "residual_targets": {
          "type": "array",
          "items": {"$ref": "#/$defs/Id"},
          "uniqueItems": true
        },
        "retention_reason": {"$ref": "#/$defs/Id"},
        "replacement_session_id": {"$ref": "#/$defs/Id"}
      },
      "allOf": [
        {
          "if": {"properties": {"outcome": {"const": "retention_held"}}},
          "then": {"required": ["retention_reason"]}
        },
        {
          "if": {"properties": {"outcome": {"const": "replaced"}}},
          "then": {"required": ["replacement_session_id"]}
        }
      ],
      "additionalProperties": false
    }
  }
}
